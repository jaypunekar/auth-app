# This is a template for production environment variables
# When deploying to Amplify, set these variables in the Amplify Console

# API URL - This will be replaced by Amplify environment variables
# Do not include /api at the end - it's added in the code
REACT_APP_API_URL=${API_URL}

# Other environment variables
REACT_APP_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY} 